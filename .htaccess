# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php54” package as the default “PHP” programming language.
<IfModule mime_module>

</IfModule>
# php -- END cPanel-generated handler, do not edit

ErrorDocument 404 /404.html

# Sayğacın məlumat faylı çöldən oxunmasın (counter.php istifadə edir)
<Files "counter.dat">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

RewriteEngine On

# Every 301 below writes an explicit https:// target. The origin sits behind a
# CDN that terminates TLS, so Apache thinks the request is plain http and would
# otherwise redirect to http:// — costing an extra CDN hop on every redirect.
# http -> https itself is already handled by the CDN and is deliberately NOT
# repeated here (that would risk a redirect loop).

# ---------------------------------------------------------------------------
# 1. Domain consolidation — avtoprays.ru -> avtoprays.az
#     Both hosts are served the same repo, so this rule has to be conditional:
#     it fires only on the .ru host and is inert on .az. Keep it above the
#     legacy/clean-URL blocks — the .az side re-applies those anyway, so a
#     .ru request never needs more than one extra hop.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} (^|\.)avtoprays\.ru$ [NC]
RewriteRule ^(.*)$ https://avtoprays.az/$1 [R=301,L]

# ---------------------------------------------------------------------------
# 2. Hostname normalisation — www.* -> bare domain (works for both .ru and .az)
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 3. Legacy pages from the old site -> current URLs (extensionless targets)
#    These must stay ABOVE the clean-URL block: az.html, m.html, rus.html etc.
#    still physically exist in the docroot and must never be served again.
# ---------------------------------------------------------------------------

# Old timestamped autosave copies (az_260413152633.html etc.) -> homepage
RewriteRule ^az_[0-9]+\.html$ https://%{HTTP_HOST}/ [R=301,L]

# Old standalone pages -> new homepage
RewriteRule ^(az|azonlayn|onlayn|onlayn2|onlayn3|onlayn6|onlaynvideo|ruonlayn|rus|sister|vv|o|index1|indexs)\.html$ https://%{HTTP_HOST}/ [R=301,L]

# Old contract pages -> new contract page
RewriteRule ^(m|kontrakt)\.html$ https://%{HTTP_HOST}/muqavile [R=301,L]

# The extensionless form of a legacy name must not fall through to the legacy
# file below — send those to the homepage as well.
RewriteRule ^(az|azonlayn|onlayn|onlayn2|onlayn3|onlayn6|onlaynvideo|ruonlayn|rus|sister|vv|o|index1|indexs)/?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(m|kontrakt)/?$ https://%{HTTP_HOST}/muqavile [R=301,L]

# ---------------------------------------------------------------------------
# 4. Clean URLs — /korporativ instead of /korporativ.html
#    a) 301 the old .html address to the clean one (one hop, no loop: the
#       condition looks at the literal request line, not the rewritten path)
#    b) serve the real .html file for the clean address, internally
#    The page list is an explicit whitelist on purpose, so a clean URL can
#    never expose one of the leftover legacy .html files in the docroot.
# ---------------------------------------------------------------------------

# /index.html and /index -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]

# /<page>.html -> /<page>
RewriteCond %{THE_REQUEST} \s/+(korporativ|qadin-suruculer|valideynler-ucun|vip-suruculer|muqavile)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# /<page>/ -> /<page>  (no trailing slash on page URLs)
RewriteRule ^(korporativ|qadin-suruculer|valideynler-ucun|vip-suruculer|muqavile)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# /<page> -> <page>.html  (internal, address bar keeps the clean URL)
RewriteRule ^(korporativ|qadin-suruculer|valideynler-ucun|vip-suruculer|muqavile)$ $1.html [L]

# ---------------------------------------------------------------------------
# 5. Compression (the CDN already gzips, this covers direct origin hits)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 6. Browser caching. HTML stays uncached so content edits appear immediately;
#    css/js are versioned with ?v=… in the markup, so they can cache hard.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Basic hardening
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---------------------------------------------------------------------------
# 7. Correct charset for the Azerbaijani text
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8
